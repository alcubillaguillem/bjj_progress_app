@inherits LayoutComponentBase
@implements IDisposable
@inject ProfileService Profiles
@inject AuthService Auth
@inject SyncService Sync
@inject SyncCoordinator Coordinator
@inject NavigationManager Nav

@if (!_ready)
{
    <div class="boot"><img src="icon.svg" alt="@L["Cargando"]" /></div>
}
else
{
    <div class="shell">
        <aside class="sidebar">
            <a class="brand" href="./"><img src="icon.svg" width="32" height="32" alt="" />BJJ Journal</a>
            <a class="btn primary add-side" href="sesiones/nueva"><Icon Name="plus" />@L["Nueva sesión"]</a>
            <nav class="side-nav" aria-label="@L["Secciones"]">
                <NavLink class="nav-btn" href="" Match="NavLinkMatch.All" ActiveClass="active"><Icon Name="home" />@L["Inicio"]</NavLink>
                <NavLink class="nav-btn" href="sesiones" ActiveClass="active"><Icon Name="calendar" />@L["Sesiones"]</NavLink>
                <NavLink class="nav-btn" href="tecnicas" ActiveClass="active"><Icon Name="book" />@L["Técnicas"]</NavLink>
                <NavLink class="nav-btn" href="cinturon" ActiveClass="active"><Icon Name="belt" />@L["Cinturón"]</NavLink>
                <NavLink class="nav-btn" href="perfil" ActiveClass="active"><Icon Name="user" />@L["Perfil"]</NavLink>
                <NavLink class="nav-btn" href="sumisiones" ActiveClass="active"><Icon Name="target" />@L["Sumisiones"]</NavLink>
                <NavLink class="nav-btn" href="ajustes" ActiveClass="active"><Icon Name="settings" />@L["Ajustes"]</NavLink>
            </nav>
            <a class="side-foot" href="ajustes" style="display:flex; gap:8px; align-items:center; color:var(--muted)">
                <span class="sync-dot @(Auth.IsSignedIn ? (Sync.LastError is null ? "" : "err") : "off")"></span>
                <span>@SyncLabel</span>
            </a>
        </aside>

        <main class="content">
            @Body
        </main>

        <nav class="tabbar" aria-label="@L["Secciones"]">
            <NavLink class="tab-btn" href="" Match="NavLinkMatch.All" ActiveClass="active"><Icon Name="home" /><span>@L["Inicio"]</span></NavLink>
            <NavLink class="tab-btn" href="sesiones" Match="NavLinkMatch.All" ActiveClass="active"><Icon Name="calendar" /><span>@L["Sesiones"]</span></NavLink>
            <a class="tab-add" href="sesiones/nueva" aria-label="@L["Nueva sesión"]"><Icon Name="plus" /></a>
            <NavLink class="tab-btn" href="tecnicas" ActiveClass="active"><Icon Name="book" /><span>@L["Técnicas"]</span></NavLink>
            <NavLink class="tab-btn" href="perfil" ActiveClass="active"><Icon Name="user" /><span>@L["Perfil"]</span></NavLink>
        </nav>
    </div>
}
<Toast />

@code {
    private bool _ready;

    private string SyncLabel => !Auth.IsSignedIn
        ? L["Solo en este dispositivo"]
        : Sync.IsSyncing ? L["Sincronizando…"]
        : Sync.LastError is { } err ? L[err] : $"{L["Sincronizado"]} · {Auth.Session!.Email}";

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += Refresh;
        Sync.StatusChanged += Refresh;

        if (Auth.IsConfigured)
        {
            var hadTokens = Nav.Uri.Contains("access_token=", StringComparison.Ordinal) || Nav.Uri.Contains("error_description=", StringComparison.Ordinal);
            var error = await Auth.InitializeAsync(Nav.Uri);
            if (error is not null)
            {
                Nav.NavigateTo($"acceso?error={Uri.EscapeDataString(error)}", replace: true);
                return;
            }

            if (hadTokens)
            {
                // Quita los tokens de la barra de direcciones tras volver de Google.
                Nav.NavigateTo("./", replace: true);
            }

            if (!Auth.IsSignedIn && !await Auth.IsGuestAsync())
            {
                Nav.NavigateTo("acceso", replace: true);
                return;
            }

            if (Auth.IsSignedIn)
            {
                await Sync.SyncAsync();
            }
        }

        if (!await Profiles.IsOnboardedAsync())
        {
            Nav.NavigateTo("bienvenida", replace: true);
            return;
        }

        _ready = true;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Auth.Changed -= Refresh;
        Sync.StatusChanged -= Refresh;
    }
}

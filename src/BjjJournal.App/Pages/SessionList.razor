@page "/sesiones"
@inject SessionService SessionsSvc

<PageTitle>@L["Sesiones"] · BJJ Journal</PageTitle>

<div class="view">
    <div class="view-head">
        <h1 class="title">@L["Sesiones"]</h1>
        <div class="actions">
            @if (!_calendar) { <button class="btn pill @(_showFilters ? "on" : "")" @onclick="() => _showFilters = !_showFilters"><Icon Name="search" />@L["Filtros"]@(ActiveFilters > 0 ? $" ({ActiveFilters})" : "")</button> }
            <a class="btn primary pill" style="background:var(--accent)" href="sesiones/nueva"><Icon Name="plus" />@L["Nueva"]</a>
        </div>
    </div>

    <div class="segmented" style="max-width:320px">
        <button type="button" class="@(_calendar ? "on" : "")" @onclick="() => _calendar = true"><Icon Name="calendar" /> @L["Calendario"]</button>
        <button type="button" class="@(_calendar ? "" : "on")" @onclick="() => _calendar = false"><Icon Name="book" /> @L["Lista"]</button>
    </div>

    @if (_calendar)
    {
        <SessionCalendar />
    }
    else
    {
    @if (_showFilters)
    {
        <div class="card filters">
            <div class="filter-row">
                <label class="field">@L["Desde"]<input type="date" @bind="_from" @bind:after="LoadAsync" /></label>
                <label class="field">@L["Hasta"]<input type="date" @bind="_to" @bind:after="LoadAsync" /></label>
                <label class="field">@L["Tipo"]
                    <select @bind="_type" @bind:after="LoadAsync">
                        <option value="">@L["Todos"]</option>
                        @foreach (var t in Enum.GetValues<SessionType>()) { <option value="@t">@Labels.Of(t)</option> }
                    </select>
                </label>
                <label class="field">Gi / No-gi
                    <select @bind="_attire" @bind:after="LoadAsync">
                        <option value="">@L["Ambos"]</option>
                        @foreach (var a in Enum.GetValues<Attire>()) { <option value="@a">@Labels.Of(a)</option> }
                    </select>
                </label>
                <label class="field">@L["Satisfacción mínima"]
                    <select @bind="_minSat" @bind:after="LoadAsync">
                        <option value="">@L["Cualquiera"]</option>
                        @for (var i = 2; i <= 5; i++) { <option value="@i">@L.F("{0} o más", i)</option> }
                    </select>
                </label>
            </div>
            @if (ActiveFilters > 0)
            {
                <button class="btn ghost small" @onclick="ClearAsync"><Icon Name="x" />@L["Quitar filtros"]</button>
            }
        </div>
    }

    @if (_items is not null)
    {
        <div class="small muted">@L.N(_items.Count, "sesión", "sesiones") · @Format.Hours(_items.Sum(s => s.DurationMinutes) / 60.0) h</div>
        <div class="card list-card">
            @if (_items.Count == 0)
            {
                <div class="empty">@L[ActiveFilters > 0 ? "Ninguna sesión cumple los filtros." : "Aún no hay sesiones."]</div>
            }
            else
            {
                <div class="list">
                    @foreach (var month in _items.GroupBy(s => Format.Local(s.StartedAt).ToString("MMMM yyyy")))
                    {
                        <div class="day"><span>@month.Key</span><span>@month.Count() · @Format.Hours(month.Sum(s => s.DurationMinutes) / 60.0) h</span></div>
                        @foreach (var s in month)
                        {
                            <SessionRow Session="s" />
                        }
                    }
                </div>
            }
        </div>
    }
    }
</div>

@code {
    private IReadOnlyList<SessionListItem>? _items;
    private bool _calendar = true;
    private bool _showFilters;
    private DateOnly? _from;
    private DateOnly? _to;
    private SessionType? _type;
    private Attire? _attire;
    private int? _minSat;

    private int ActiveFilters => new object?[] { _from, _to, _type, _attire, _minSat }.Count(x => x is not null);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() =>
        _items = await SessionsSvc.ListAsync(new SessionFilter(_from, _to, _type, _attire, _minSat));

    private Task ClearAsync()
    {
        (_from, _to, _type, _attire, _minSat) = (null, null, null, null, null);
        return LoadAsync();
    }
}

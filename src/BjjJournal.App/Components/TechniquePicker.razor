@* Buscador de técnicas para el formulario de sesión. Permite crear una técnica nueva sin salir del formulario. *@
@inject TechniqueService Techniques
@inject PositionService Positions

<div class="form">
    <div class="search-box">
        <Icon Name="search" />
        <input placeholder="@L["Buscar o crear técnica…"]" @bind="_query" @bind:event="oninput" @bind:after="Search" />
    </div>

    @if (_creating)
    {
        <div class="sub-card">
            <div class="roll-head"><strong>@L["Nueva técnica"]</strong><button type="button" class="icon-btn" aria-label="@L["Cancelar"]" @onclick="() => _creating = false"><Icon Name="x" /></button></div>
            <label class="field">@L["Nombre"]<input @bind="_new.Name" /></label>
            <div class="field-row">
                <label class="field">@L["Categoría"]
                    <select @bind="_new.Category">
                        @foreach (var c in Enum.GetValues<TechniqueCategory>()) { <option value="@c">@Labels.Of(c)</option> }
                    </select>
                </label>
                <label class="field">@L["Posición"]
                    <select @bind="_new.PositionId">
                        <option value="">@L["Sin posición"]</option>
                        @foreach (var p in _positions) { <option value="@p.Id">@p.Name</option> }
                    </select>
                </label>
            </div>
            @if (_error is not null) { <div class="error">@L[_error]</div> }
            <button type="button" class="btn primary" @onclick="CreateAsync"><Icon Name="check" />@L["Crear y añadir"]</button>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_query))
    {
        <div class="picker-results">
            @foreach (var t in _results)
            {
                var item = t;
                <button type="button" @onclick="() => PickAsync(item.Id)">
                    <span class="dot" style="background:@Labels.CategoryColor(item.Category)"></span>@item.Name
                    <span class="meta">@(item.PositionName ?? Labels.Of(item.Category))</span>
                </button>
            }
            <button type="button" @onclick="StartCreate"><span class="accent"><Icon Name="plus" /></span>@L.F("Crear «{0}»", _query.Trim())</button>
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyCollection<Guid> Exclude { get; set; } = [];
    [Parameter] public EventCallback<Guid> OnPick { get; set; }
    /// <summary>Se avisa cuando se crea una técnica nueva, para que el formulario recargue la lista.</summary>
    [Parameter] public EventCallback OnCreated { get; set; }

    private string _query = "";
    private IReadOnlyList<TechniqueListItem> _results = [];
    private IReadOnlyList<PositionDto> _positions = [];
    private bool _creating;
    private TechniqueInput _new = new();
    private string? _error;

    private async Task Search()
    {
        _results = string.IsNullOrWhiteSpace(_query)
            ? []
            : (await Techniques.SearchAsync(new TechniqueFilter(_query))).Where(t => !Exclude.Contains(t.Id)).Take(8).ToList();
    }

    private async Task StartCreate()
    {
        _positions = await Positions.ListAsync();
        _new = new TechniqueInput { Name = _query.Trim() };
        _error = null;
        _creating = true;
    }

    private async Task CreateAsync()
    {
        var result = await Techniques.CreateAsync(_new);
        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        _creating = false;
        await OnCreated.InvokeAsync();
        await PickAsync(result.Value);
    }

    private async Task PickAsync(Guid id)
    {
        _query = "";
        _results = [];
        await OnPick.InvokeAsync(id);
    }
}

@page "/tecnicas"
@* Pantalla /tecnicas: biblioteca de técnicas en bloques por categoría, con buscador. *@

<PageTitle>@L["Técnicas"] · BJJ Journal</PageTitle>

<div class="view">
    <div class="view-head">
        <h1 class="title">@L["Técnicas"]</h1>
        <div class="actions">
            <a class="btn pill" href="cinturon"><Icon Name="belt" />@L["Cinturón"]</a>
            <a class="btn primary pill" style="background:var(--accent)" href="tecnicas/nueva"><Icon Name="plus" />@L["Nueva"]</a>
        </div>
    </div>

    <div class="search-box">
        <Icon Name="search" />
        <input type="search" placeholder="@L["Buscar técnica, posición o etiqueta…"]" @bind="_query" @bind:event="oninput" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_query))
    {
        var results = Journal.Search(_query).OrderByDescending(t => Use(t).Count).ToList();
        <div class="small muted">@L.N(results.Count, "resultado", "resultados")</div>
        @if (results.Count == 0)
        {
            <div class="card empty">@L["No hay técnicas que coincidan."] <a href="tecnicas/nueva">@L["Crear una"]</a></div>
        }
        <div class="t-grid">
            @foreach (var t in results) { <TechniqueCard T="t" Use="Use(t)" ShowCategory="true" /> }
        </div>
    }
    else
    {
        <div class="t-summary">
            <div><b>@_all.Count</b><span>@L["técnicas"]</span></div>
            <div><b>@_all.Count(t => t.Progress == ProgressStatus.Mastered)</b><span>@L["dominadas"]</span></div>
            <div><b>@_all.Count(t => t.Progress == ProgressStatus.Competent)</b><span>@L["competentes"]</span></div>
            <div><b>@_all.Count(t => t.Progress == ProgressStatus.Learning)</b><span>@L["aprendiendo"]</span></div>
        </div>

        <div class="cat-grid">
            @foreach (var c in Enum.GetValues<TechniqueCategory>())
            {
                var items = _all.Where(t => t.Category == c).ToList();
                <a class="cat-tile @(items.Count == 0 ? "empty-tile" : "")" href="tecnicas/categoria/@Labels.Slug(c)" style="--c:@Labels.CategoryColor(c)">
                    <img class="cat-img" src="img/categorias/@(Labels.Slug(c)).webp" alt="" />
                    <span class="cat-ic"><Icon Name="@Labels.CategoryIcon(c)" /></span>
                    <span class="cat-name">@Labels.Of(c)</span>
                    <span class="cat-count">@L.N(items.Count, "técnica", "técnicas")</span>
                    <span class="cat-stack" aria-hidden="true">
                        @foreach (var s in new[] { ProgressStatus.Mastered, ProgressStatus.Competent, ProgressStatus.Learning })
                        {
                            var n = items.Count(t => t.Progress == s);
                            if (n > 0) { <i class="p-@s" style="flex:@n"></i> }
                        }
                        @if (items.Count(t => t.Progress == ProgressStatus.NotStarted) is var rest && rest > 0) { <i class="p-NotStarted" style="flex:@rest"></i> }
                    </span>
                    @if (items.Count > 0)
                    {
                        <span class="cat-top">@items.OrderByDescending(t => Use(t).Count).First().Name</span>
                    }
                </a>
            }
        </div>
    }
</div>

@code {
    private List<Technique> _all = [];
    private Dictionary<Guid, (int Count, DateTimeOffset Last)> _usage = [];
    private string _query = "";

    private (int Count, DateTimeOffset Last) Use(Technique t) => _usage.GetValueOrDefault(t.Id);

    // Ordena las técnicas y cuenta cuántas veces se ha usado cada una.
    protected override void OnInitialized()
    {
        _all = Journal.Techniques.OrderBy(t => t.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        _usage = Journal.Usage();
    }
}

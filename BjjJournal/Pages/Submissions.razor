@page "/sumisiones"
@* Pantalla /sumisiones: ranking de sumisiones a favor y en contra, por mes o de siempre. *@

<PageTitle>@L["Sumisiones"] · BJJ Journal</PageTitle>

<div class="view narrow">
    <div class="back-row">
        <a class="round-btn" aria-label="@L["Volver"]" href="perfil"><Icon Name="left" /></a>
        <h1 class="subtitle">@L["Sumisiones"]</h1>
    </div>

    <div class="segmented">
        <button type="button" class="@(_kind == RollEventKind.SubmissionFor ? "on" : "")" @onclick="() => _kind = RollEventKind.SubmissionFor">@L["A favor"]</button>
        <button type="button" class="@(_kind == RollEventKind.SubmissionAgainst ? "on" : "")" @onclick="() => _kind = RollEventKind.SubmissionAgainst">@L["En contra"]</button>
    </div>

    <div class="card">
        <div class="month-nav">
            <button class="round-btn" aria-label="@L["Mes anterior"]" disabled="@_allTime" @onclick="() => _month = _month.AddMonths(-1)"><Icon Name="left" /></button>
            <button class="btn ghost small" @onclick="() => _allTime = !_allTime" title="@L["Cambiar entre mes y todo el histórico"]">
                <strong>@(_allTime ? L["Todo el histórico"] : _month.ToString("MMMM yyyy"))</strong>
            </button>
            <button class="round-btn" aria-label="@L["Mes siguiente"]" disabled="@(_allTime || _month >= ThisMonth)" @onclick="() => _month = _month.AddMonths(1)"><Icon Name="right" /></button>
        </div>

        @{ var data = Data(); }
        <RadarChart Axes="@Axes(data)" Color="@(_kind == RollEventKind.SubmissionFor ? "#f87171" : "#94a3b8")" AriaLabel="@L["Sumisiones"]" />

        <div class="summary-line" style="margin:12px 0">
            <span><b>@data.Total</b> @L["total"] · <b>@data.Unique</b> @L["distintas"]</span>
            <label class="chip @(_withPositions ? "on" : "")" style="cursor:pointer">
                <input type="checkbox" checked="@_withPositions" @onchange="() => _withPositions = !_withPositions" style="display:none" />
                <Icon Name="pin" />@L["Con posiciones"]
            </label>
        </div>

        @if (data.Items.Count == 0)
        {
            <div class="empty">@L["No hay sumisiones en este periodo."]</div>
        }
        else
        {
            <div class="rank">
                @foreach (var item in data.Items)
                {
                    <div class="rank-row">
                        <div class="name">@L[item.Name]@if (item.Position is not null) { <span class="tag">@item.Position</span> }</div>
                        <div class="count">@item.Count</div>
                        <div class="bar"><div class="fill" style="width:@Pct(item.Share); background:@(_kind == RollEventKind.SubmissionFor ? "#f87171" : "#94a3b8")"></div></div>
                        <div class="pct">@((item.Share * 100).ToString("0.#"))%</div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private static DateOnly ThisMonth => new(Stats.Today.Year, Stats.Today.Month, 1);

    private DateOnly _month = ThisMonth;
    private bool _allTime;
    private bool _withPositions;
    private RollEventKind _kind = RollEventKind.SubmissionFor;

    // Ranking de un mes concreto o de siempre.
    private Ranking Data(DateOnly? month = null, bool? allTime = null)
    {
        var m = month ?? _month;
        var sessions = (allTime ?? _allTime) ? Journal.Sessions : Journal.Sessions.Where(s => s.Day.Year == m.Year && s.Day.Month == m.Month);
        return Stats.Submissions(Journal, sessions, _kind, _withPositions);
    }

    private List<RadarChart.Axis> Axes(Ranking data) =>
        data.Items.Take(6).Select(i => new RadarChart.Axis(i.Position is null ? L[i.Name] : $"{L[i.Name]} · {i.Position}", i.Count)).ToList();

    // Elige qué mes mostrar al entrar.
    protected override void OnInitialized()
    {
        // Si el mes actual está vacío, abre el último mes con sumisiones (hasta 2 años atrás).
        if (Data().Total == 0 && Data(allTime: true).Total > 0)
        {
            for (var i = 0; i < 24 && Data().Total == 0; i++)
            {
                _month = _month.AddMonths(-1);
            }
        }
    }

    private static string Pct(double v) => (Math.Clamp(v, 0, 1) * 100).ToString("0.#", CultureInfo.InvariantCulture) + "%";
}

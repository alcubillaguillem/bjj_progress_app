@* Aviso breve abajo ("Sesión guardada"). Desde cualquier página: Toast.Show("texto"). *@
@implements IDisposable

<div class="toast @(_visible ? "show" : "")" role="status" aria-live="polite">@_message</div>

@code {
    private static event Action<string>? Shown;

    public static void Show(string message) => Shown?.Invoke(message);

    private string _message = "";
    private bool _visible;
    private int _version;

    protected override void OnInitialized() => Shown += OnShown;

    private async void OnShown(string message)
    {
        var version = ++_version;
        _message = message;
        _visible = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2200);
        if (version == _version)
        {
            _visible = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => Shown -= OnShown;
}

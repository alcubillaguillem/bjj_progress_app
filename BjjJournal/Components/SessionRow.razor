@* Fila de una sesión en las listas: tipo, gi/no-gi, duración y satisfacción. *@
<a class="item" href="sesiones/@Session.Id">
    <span class="cat-ic"><Icon Name="@(Session.Type == SessionType.Competition ? "target" : "calendar")" /></span>
    <span class="info">
        <div class="note">@Labels.Of(Session.Type) · @Labels.Of(Session.Attire)</div>
        <div class="meta">
            @Format.Day(Session.StartedAt)@(Session.Location is null ? "" : $" · {Session.Location}")
            @if (Session.Rolls.Count > 0) { <text> · @Session.Rolls.Count @L["rolls"]</text> }
            @if (For + Against > 0) { <text> · @For–@Against</text> }
        </div>
    </span>
    <span class="amt">@Format.Minutes(Session.DurationMinutes)<small><Stars Value="Session.Satisfaction" /></small></span>
</a>

@code {
    [Parameter, EditorRequired] public TrainingSession Session { get; set; } = default!;

    private int For => Session.Count(RollEventKind.SubmissionFor);
    private int Against => Session.Count(RollEventKind.SubmissionAgainst);
}
